{
  "$comment": "Esboço histórico (superado). NAVIGATION, CONTENT_BLOCK e presentation já estão implementados (TD56); o contrato vale pelo que está em packages/types e packages/validation, e as seis composições reais estão em packages/hotsite-templates/definitions/.",
  "schemaAdditions": {
    "moduleType": "CONTENT_BLOCK",
    "modulePresentation": {
      "surface": "background | secondary | primary | custom",
      "contentWidth": "narrow | standard | wide | full",
      "minHeight": "auto | sm | md | lg | viewport",
      "padding": "compact | comfortable | spacious | none",
      "background": {
        "imageUrl": "string | null",
        "position": "left | center | right",
        "overlay": {
          "type": "none | solid | linear-gradient",
          "direction": "to-right | to-left | to-bottom | to-top",
          "fromColor": "#RRGGBB",
          "fromOpacity": 0,
          "toColor": "#RRGGBB",
          "toOpacity": 0
        }
      }
    },
    "contentBlockData": {
      "variant": "trust-grid | image-statement | immersive-statement | process-steps | collage-callout | technical-callout",
      "eyebrow": "string | optional",
      "title": "string",
      "body": "markdown | optional",
      "items": "variant-specific structured content",
      "cta": { "label": "string", "target": "booking-form | service-list | gallery | testimonials | about | contact | lead-form" }
    }
  },
