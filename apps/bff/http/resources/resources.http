# BFF — Resource Management endpoints (M21-S01, UC-044–UC-049)
# JWT required. Role: MANAGER only — a deliberate, self-consistent restriction distinct from
# every other Booking-context admin surface (docs/14-API_CONTRACTS.md § Resource Management).
#
# Prerequisites:
#   1. pnpm infra:up
#   2. pnpm --filter @ikaro/backend run migration:run
#   3. pnpm --filter @ikaro/backend run dev
#   4. pnpm --filter @ikaro/bff run dev
#   5. ENABLE_DEV_AUTH=true in apps/bff/.env.local
#
# REST Client environment: select "local" in VS Code status bar

# ── File-level response captures (updated automatically when login/create requests run) ──
@managerToken = {{managerLogin.response.body.accessToken}}
@staffToken   = {{staffLogin.response.body.accessToken}}
@resourceId   = {{createResource.response.body.id}}

# ── DEV AUTH — run each login once per session, then use the captured token ──

###
# @name managerLogin
POST {{bffUrl}}/v1/auth/dev-login
Content-Type: application/json

{ "email": "admin@lavacar.com.br", "tenantSlug": "{{tenantSlug}}", "type": "staff" }

###
# @name staffLogin
POST {{bffUrl}}/v1/auth/dev-login
Content-Type: application/json

{ "email": "staff@lavacar.com.br", "tenantSlug": "{{tenantSlug}}", "type": "staff" }

# ─────────────────────────────────────────────────────────────────────────────
# HAPPY PATH — list resources (UC-044)
# ─────────────────────────────────────────────────────────────────────────────

###

### List all resources
GET {{bffUrl}}/v1/resources
Authorization: Bearer {{managerToken}}

###

### List active ROOM resources only
GET {{bffUrl}}/v1/resources?type=ROOM&isActive=true
Authorization: Bearer {{managerToken}}

# ─────────────────────────────────────────────────────────────────────────────
# HAPPY PATH — create a resource (UC-045)
# ─────────────────────────────────────────────────────────────────────────────

###

### Create a ROOM resource
# @name createResource
POST {{bffUrl}}/v1/resources
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{
  "type": "ROOM",
  "name": "Estúdio 1",
  "maxCapacity": 12
}

# ─────────────────────────────────────────────────────────────────────────────
# HAPPY PATH — edit a resource (UC-046) — every field independently optional
# ─────────────────────────────────────────────────────────────────────────────

###

### Update working hours
PATCH {{bffUrl}}/v1/resources/{{resourceId}}
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{
  "workingHours": {
    "monday": { "open": "09:00", "close": "18:00" },
    "tuesday": { "open": "09:00", "close": "18:00" },
    "wednesday": { "open": "09:00", "close": "18:00" },
    "thursday": { "open": "09:00", "close": "18:00" },
    "friday": { "open": "09:00", "close": "18:00" },
    "saturday": null,
    "sunday": null
  }
}

###

### Update name, type, and maxCapacity
PATCH {{bffUrl}}/v1/resources/{{resourceId}}
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{
  "name": "Estúdio 2",
  "type": "EQUIPMENT",
  "maxCapacity": 8
}

# ─────────────────────────────────────────────────────────────────────────────
# HAPPY PATH — deactivate / reactivate (UC-047, UC-049)
# ─────────────────────────────────────────────────────────────────────────────

###

### Deactivate a resource
DELETE {{bffUrl}}/v1/resources/{{resourceId}}
Authorization: Bearer {{managerToken}}

###

### Reactivate a resource
POST {{bffUrl}}/v1/resources/{{resourceId}}/reactivate
Authorization: Bearer {{managerToken}}

# ─────────────────────────────────────────────────────────────────────────────
# ERROR CASES
# ─────────────────────────────────────────────────────────────────────────────

###

### 403 — STAFF role not allowed on Resource Management
GET {{bffUrl}}/v1/resources
Authorization: Bearer {{staffToken}}

###

### 422 — LOCATION type rejected (domain-level: never manually created, backfill-only, S02)
POST {{bffUrl}}/v1/resources
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{
  "type": "LOCATION",
  "name": "Unidade Única"
}

###

### 404 — Resource not found
DELETE {{bffUrl}}/v1/resources/00000000-0000-4000-8000-000000000099
Authorization: Bearer {{managerToken}}
