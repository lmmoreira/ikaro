# BFF — Public signup (no JWT)
# UC-127, UC-128: the slug check, the session read and the signup POST behind /ikaro-trial.
#
# Prerequisites:
#   1. pnpm infra:up
#   2. pnpm --filter @ikaro/backend run migration:run
#   3. pnpm --filter @ikaro/backend run dev
#   4. pnpm --filter @ikaro/bff run dev
#
# REST Client environment: select "local" in the VS Code status bar.
# The BFF answers only requests that carry the web key (WebOnlyGuard, every route, public or not):
# WEB_INTERNAL_KEY is read from apps/bff/.env.

@webInternalKey = {{$dotenv WEB_INTERNAL_KEY}}
# Throttled at 30 requests per minute per IP in staging and production only (local is exempt);
# always `Cache-Control: no-store`. Turnstile is not checked here, only on the final signup POST.

# ─────────────────────────────────────────────────────────────────────────────
# HAPPY PATH
# ─────────────────────────────────────────────────────────────────────────────

### A free, valid slug → 200 { "status": "available" }
GET {{bffUrl}}/v1/public/signup/slug-availability?slug=lavacar-top-nova
X-Web-Internal-Key: {{webInternalKey}}

### An existing tenant's slug → 200 { "status": "taken" } (replace with a seeded slug)
GET {{bffUrl}}/v1/public/signup/slug-availability?slug=autospa-premium
X-Web-Internal-Key: {{webInternalKey}}

# ─────────────────────────────────────────────────────────────────────────────
# VERDICTS
# ─────────────────────────────────────────────────────────────────────────────

### A reserved word → 200 { "status": "reserved" }
GET {{bffUrl}}/v1/public/signup/slug-availability?slug=admin
X-Web-Internal-Key: {{webInternalKey}}

### Too long → 200 { "status": "invalid", "reason": "TOO_LONG" }
GET {{bffUrl}}/v1/public/signup/slug-availability?slug=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
X-Web-Internal-Key: {{webInternalKey}}

### Leading hyphen → 200 { "status": "invalid", "reason": "INVALID_HYPHEN" }
GET {{bffUrl}}/v1/public/signup/slug-availability?slug=-lavacar
X-Web-Internal-Key: {{webInternalKey}}

# ─────────────────────────────────────────────────────────────────────────────
# ERRORS
# ─────────────────────────────────────────────────────────────────────────────

### Missing slug parameter → 400
GET {{bffUrl}}/v1/public/signup/slug-availability
X-Web-Internal-Key: {{webInternalKey}}

# ─────────────────────────────────────────────────────────────────────────────
# SELF-SIGNUP (UC-127)
# The Google step sets a 30-minute signup-session cookie (GET /v1/auth/google?type=signup in a
# browser). Without Google, the dev issuer sets the same cookie: it needs ENABLE_DEV_AUTH=true and
# is refused in production. Throttled at 10 per minute per IP in staging and production only.
# ─────────────────────────────────────────────────────────────────────────────

### Dev only: set the signup-session cookie without Google (the REST Client keeps it for the next calls)
POST {{bffUrl}}/v1/auth/dev-signup-session
X-Web-Internal-Key: {{webInternalKey}}
Content-Type: application/json

{
  "email": "dona@example.com",
  "name": "Dona",
  "googleSub": "112233445566778899001"
}

### The verified Google identity, the read-only trial answer and the Terms version to accept.
### 401 without the cookie, 503 SIGNUP_CLOSED while FEATURE_FLAG_SIGNUP_ENABLED is off.
GET {{bffUrl}}/v1/public/signup/session
X-Web-Internal-Key: {{webInternalKey}}

### Create the tenant. The email and name come from the session, never from the body. Turnstile is
### verified once here (the local secret is Cloudflare's always-pass test key). 201 and a
### signup-resend cookie; 409 SIGNUP_TRIAL_NOT_AVAILABLE / SIGNUP_SLUG_TAKEN, 422 for the slug, the
### tax id, the Terms version or the country, 400 SIGNUP_TURNSTILE_FAILED, 429 SIGNUP_RATE_LIMITED.
POST {{bffUrl}}/v1/public/signup/tenant
X-Web-Internal-Key: {{webInternalKey}}
Content-Type: application/json

{
  "businessName": "Lavacar Top Nova",
  "slug": "lavacar-top-nova",
  "countryCode": "BR",
  "taxId": "529.982.247-25",
  "acceptedTermsVersion": "2026-11",
  "turnstileToken": "XXXX.DUMMY.TOKEN.XXXX"
}
