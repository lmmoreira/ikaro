# BFF — Hotsite Admin (M12-S02 / M12-S10)
# UC-027: Admin manages hotsite content
# Guarded by @Roles('MANAGER') — requires a manager JWT (Authorization: Bearer <token>).
#
# Prerequisites:
#   1. pnpm infra:up
#   2. pnpm --filter @ikaro/backend run migration:run
#   3. pnpm --filter @ikaro/backend run seed
#   4. pnpm --filter @ikaro/backend run dev  (port 3001)
#   5. pnpm --filter @ikaro/bff run dev      (port 3002)
#   6. ENABLE_DEV_AUTH=true in apps/bff/.env.local
#
# REST Client environment: select "local" in VS Code status bar

# ── File-level response captures (updated automatically when login request runs) ──
@managerToken = {{managerLogin.response.body.accessToken}}
@staffToken   = {{staffLogin.response.body.accessToken}}

###
# @name managerLogin
POST {{bffUrl}}/v1/auth/dev-login
Content-Type: application/json

{ "email": "admin@lavacar.com.br", "tenantSlug": "{{tenantSlug}}", "type": "staff" }

###
# @name staffLogin
POST {{bffUrl}}/v1/auth/dev-login
Content-Type: application/json

{ "email": "funcionario@lavacar.com.br", "tenantSlug": "{{tenantSlug}}", "type": "staff" }

# ─────────────────────────────────────────────────────────────────────────────
# HAPPY PATH
# ─────────────────────────────────────────────────────────────────────────────

### Get full hotsite content (includes unpublished state)
GET {{bffUrl}}/v1/tenants/hotsite
Authorization: Bearer {{managerToken}}

###

### Generate signed URL for a branding logo upload
POST {{bffUrl}}/v1/tenants/hotsite/images/signed-url
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "fileName": "logo.png",
  "contentType": "image/png",
  "purpose": "branding"
}

###

### Generate a private read-signed URL for a not-yet-promoted tmp/ image (TD22)
POST {{bffUrl}}/v1/tenants/hotsite/images/read-signed-url
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "filePath": "tmp/{{tenantId}}/branding/019f420c-0000-0000-0000-000000000000/logo.png"
}

###

### Partial branding update (only colors changed)
PATCH {{bffUrl}}/v1/tenants/hotsite
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "branding": {
    "primaryColor": "#f97316",
    "secondaryColor": "#fff7ed"
  }
}

###

### Layout update — NAVIGATION first, an immersive hero with an overlay, a numbered service list and a custom-surface About (TD56)
PATCH {{bffUrl}}/v1/tenants/hotsite
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "layout": [
    { "type": "NAVIGATION", "enabled": true, "data": { "items": [
      { "label": "Serviços", "target": "service-list" },
      { "label": "Sobre", "target": "about" }
    ] } },
    { "type": "HERO", "enabled": true, "data": { "variant": "immersive", "title": "Bem-vindo", "ctaLabel": "Agendar agora", "ctaTarget": "booking-form" },
      "presentation": { "minHeight": "viewport", "overlay": { "type": "linear-gradient", "direction": "to-top", "fromColor": "#090909", "fromOpacity": 0.88, "toColor": "#090909", "toOpacity": 0 } } },
    { "type": "SERVICE_LIST", "enabled": true, "data": { "showPrices": true, "showPoints": true, "layout": "numbered", "itemAction": "booking" } },
    { "type": "ABOUT", "enabled": true, "data": { "title": "Sobre nós", "body": "Texto", "imagePosition": "left", "variant": "editorial" },
      "presentation": { "surface": "custom", "customColor": "#0B0908", "contentWidth": "narrow", "padding": "spacious" } }
  ]
}

###

### Lead form config — teaser + audienceMode + questions in one atomic request (M20-S08; moved
### here from the removed PATCH /v1/tenants/lead-form/config)
PATCH {{bffUrl}}/v1/tenants/hotsite
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "layout": [
    {
      "type": "LEAD_FORM",
      "enabled": true,
      "data": { "title": "Fale com a gente", "ctaLabel": "Preencher formulário" }
    }
  ],
  "audienceMode": "GUEST_AND_CUSTOMER",
  "questions": [
    {
      "id": "01234567-0000-7000-8000-000000000101",
      "label": "Qual serviço te interessa?",
      "type": "SINGLE_CHOICE",
      "required": true,
      "options": ["Lavagem simples", "Lavagem completa", "Enceramento"],
      "order": 0
    }
  ]
}

###

### Publish the hotsite
POST {{bffUrl}}/v1/tenants/hotsite/publish
Authorization: Bearer {{managerToken}}

###

### Unpublish the hotsite
POST {{bffUrl}}/v1/tenants/hotsite/unpublish
Authorization: Bearer {{managerToken}}

###

### Feature a completed booking's after-service photo on the hotsite gallery
POST {{bffUrl}}/v1/tenants/hotsite/gallery/feature-booking-photo
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "bookingId": "{{bookingId}}",
  "photoUrl": "tenants/{{tenantId}}/bookings/{{bookingId}}/after-1.jpg"
}

###

### Delete a hotsite image from the public bucket
POST {{bffUrl}}/v1/tenants/hotsite/images/delete
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "filePath": "tenants/{{tenantId}}/hotsite/branding/u1/logo.png"
}

# ─────────────────────────────────────────────────────────────────────────────
# ERROR CASES
# ─────────────────────────────────────────────────────────────────────────────

### 403 — staff (non-manager) cannot manage the hotsite
POST {{bffUrl}}/v1/tenants/hotsite/publish
Authorization: Bearer {{staffToken}}

###

### 400 GENERIC_VALUE_INVALID on layout.0.data.layout — a known module with a value outside its enum (TD56: every module's data is validated)
PATCH {{bffUrl}}/v1/tenants/hotsite
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "layout": [
    { "type": "GALLERY", "enabled": true, "data": { "images": [], "layout": "zzz", "maxVisible": 6 } }
  ]
}

###

### 400 PLATFORM_HOTSITE_NAVIGATION_NOT_FIRST — NAVIGATION must be the first layout entry
PATCH {{bffUrl}}/v1/tenants/hotsite
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "layout": [
    { "type": "ABOUT", "enabled": true, "data": { "title": "Sobre", "body": "Texto", "imagePosition": "left" } },
    { "type": "NAVIGATION", "enabled": true, "data": { "items": [] } }
  ]
}

###

### 400 PLATFORM_HOTSITE_NAVIGATION_TARGET_NOT_ENABLED — a navigation item points at a disabled/absent module
PATCH {{bffUrl}}/v1/tenants/hotsite
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "layout": [
    { "type": "NAVIGATION", "enabled": true, "data": { "items": [ { "label": "Galeria", "target": "gallery" } ] } },
    { "type": "GALLERY", "enabled": false, "data": { "images": [], "layout": "grid", "maxVisible": 6 } }
  ]
}

###

### 400 PLATFORM_HOTSITE_MODULE_DUPLICATE — the same module type twice
PATCH {{bffUrl}}/v1/tenants/hotsite
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "layout": [
    { "type": "ABOUT", "enabled": true, "data": { "title": "Sobre", "body": "Texto", "imagePosition": "left" } },
    { "type": "ABOUT", "enabled": false, "data": { "title": "Sobre 2", "body": "Texto", "imagePosition": "right" } }
  ]
}

###

### 400 PLATFORM_HOTSITE_PRESENTATION_NOT_ALLOWED — presentation on FOOTER (also NAVIGATION, CHATBOT)
PATCH {{bffUrl}}/v1/tenants/hotsite
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "layout": [
    { "type": "FOOTER", "enabled": true, "data": {}, "presentation": { "surface": "primary" } }
  ]
}

###

### 400 PLATFORM_HOTSITE_PRESENTATION_BACKGROUND_NOT_ALLOWED — presentation.background on HERO (also BOOKING_CTA, LEAD_FORM; they keep data.backgroundImageUrl)
PATCH {{bffUrl}}/v1/tenants/hotsite
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "layout": [
    { "type": "HERO", "enabled": true, "data": { "variant": "centered", "title": "T", "ctaLabel": "Go", "ctaTarget": "booking-form" },
      "presentation": { "background": { "imageUrl": "tenants/{{tenantId}}/hotsite/section-background/019f420c-0000-0000-0000-000000000000/bg.jpg" } } }
  ]
}

###

### 400 GENERIC_VALUE_INVALID — custom surface without customColor
PATCH {{bffUrl}}/v1/tenants/hotsite
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "layout": [
    { "type": "ABOUT", "enabled": true, "data": { "title": "Sobre", "body": "Texto", "imagePosition": "left" }, "presentation": { "surface": "custom" } }
  ]
}

###

### 400 GENERIC_VALUE_INVALID — a font outside the registry
PATCH {{bffUrl}}/v1/tenants/hotsite
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "branding": { "headingFontFamily": "Comic Sans" }
}

###

### 400 — feature-booking-photo with a photoUrl that doesn't match the booking-photo path shape
POST {{bffUrl}}/v1/tenants/hotsite/gallery/feature-booking-photo
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "bookingId": "{{bookingId}}",
  "photoUrl": "not-a-valid-booking-photo-path.jpg"
}

###

### 400 — delete with a filePath outside the tenants/<id>/hotsite/... shape
POST {{bffUrl}}/v1/tenants/hotsite/images/delete
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "filePath": "tenants/{{tenantId}}/bookings/{{bookingId}}/after-1.jpg"
}
