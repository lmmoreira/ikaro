# BFF — Billing page reads (M26-S14, UC-117)
# GET /v1/billing/summary and GET /v1/billing/charges: MANAGER only (staff and customers get 403),
# reachable by the manager of a suspended tenant (the backend route declares the policy; the BFF
# carries no annotation). The tenant comes from the JWT, never from a parameter. Enums and numbers
# only, no display string and never a payment URL; a tenant with no subscription row yet answers
# 200 { "provisioning": true }.
#
# Prerequisites:
#   1. pnpm infra:up
#   2. pnpm --filter @ikaro/backend run migration:run
#   3. pnpm --filter @ikaro/backend run seed
#   4. pnpm --filter @ikaro/backend run dev  (port 3001)
#   5. pnpm --filter @ikaro/bff run dev      (port 3002)
#   6. ENABLE_DEV_AUTH=true in apps/bff/.env.local
#
# REST Client environment: select "local" in VS Code status bar

# ── File-level response captures (updated automatically when login request runs) ──
@managerToken = {{managerLogin.response.body.accessToken}}
@staffToken   = {{staffLogin.response.body.accessToken}}

###
# @name managerLogin
POST {{bffUrl}}/v1/auth/dev-login
Content-Type: application/json

{ "email": "admin@lavacar.com.br", "tenantSlug": "{{tenantSlug}}", "type": "staff" }

###
# @name staffLogin
POST {{bffUrl}}/v1/auth/dev-login
Content-Type: application/json

{ "email": "funcionario@lavacar.com.br", "tenantSlug": "{{tenantSlug}}", "type": "staff" }

### Summary
GET {{bffUrl}}/v1/billing/summary
Authorization: Bearer {{managerToken}}

### Charge history (Pattern A, newest first)
GET {{bffUrl}}/v1/billing/charges?limit=10&offset=0
Authorization: Bearer {{managerToken}}

### Out-of-range page: 400
GET {{bffUrl}}/v1/billing/charges?limit=101
Authorization: Bearer {{managerToken}}

### Staff: 403
GET {{bffUrl}}/v1/billing/summary
Authorization: Bearer {{staffToken}}

### No token: 401
GET {{bffUrl}}/v1/billing/charges

# ── Plan reads (M26-S17, UC-136) ──────────────────────────────────────────────────────────────────
# GET /v1/billing/plan and POST /v1/billing/plan/preview: MANAGER only, reachable by the manager of
# a suspended tenant. Read-only: a preview saves nothing. 422 carries the BILLING_* code of the
# plan rule; a malformed body (a duplicate feature, a tier not sold for it) is 400.

### Plan
GET {{bffUrl}}/v1/billing/plan
Authorization: Bearer {{managerToken}}

### Preview
POST {{bffUrl}}/v1/billing/plan/preview
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{ "items": [{ "featureKey": "HOTSITE", "tier": "STANDARD" }, { "featureKey": "CHATBOT", "tier": "PLUS" }] }

### Dependency unmet: 422 BILLING_FEATURE_DEPENDENCY_UNMET
POST {{bffUrl}}/v1/billing/plan/preview
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{ "items": [{ "featureKey": "HOTSITE", "tier": "STANDARD" }, { "featureKey": "LOYALTY", "tier": "STANDARD" }] }

### A feature selected twice: 400
POST {{bffUrl}}/v1/billing/plan/preview
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{ "items": [{ "featureKey": "HOTSITE", "tier": "STANDARD" }, { "featureKey": "HOTSITE", "tier": "STANDARD" }] }

### Staff: 403
GET {{bffUrl}}/v1/billing/plan
Authorization: Bearer {{staffToken}}

### No token: 401
POST {{bffUrl}}/v1/billing/plan/preview
Content-Type: application/json

{ "items": [] }

# ── Paying a charge (M26-S15, UC-119) ──────────────────────────────────────────────────────────
# `chargeId` is one of the tenant's own charges (`openCharge.id` of GET /v1/billing/summary). These
# are the only routes that return a provider URL, and only an https one.
@chargeId = 00000000-0000-7000-8000-000000000000

### Payment link: 200 { status, paymentUrl, expiresAt }; a paid charge answers
### { status: "PAID", paymentUrl: null, expiresAt: null }. 409 BILLING_CHARGE_NOT_PAYABLE,
### 422 BILLING_ADDRESS_REQUIRED, 503 BILLING_PROVIDER_UNAVAILABLE, 404 BILLING_CHARGE_NOT_FOUND
POST {{bffUrl}}/v1/billing/charges/{{chargeId}}/payment-link
Authorization: Bearer {{managerToken}}

### Payment return: 200 { status, paymentConfirmationPending }; the web calls it when the manager
### comes back from the hosted page (`?payment=return&charge={id}`)
POST {{bffUrl}}/v1/billing/charges/{{chargeId}}/payment-return
Authorization: Bearer {{managerToken}}

### Not a UUID: 400
POST {{bffUrl}}/v1/billing/charges/not-a-uuid/payment-link
Authorization: Bearer {{managerToken}}

### Staff: 403
POST {{bffUrl}}/v1/billing/charges/{{chargeId}}/payment-link
Authorization: Bearer {{staffToken}}

### No token: 401
POST {{bffUrl}}/v1/billing/charges/{{chargeId}}/payment-return
