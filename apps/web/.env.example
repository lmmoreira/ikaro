NODE_ENV=development

# Browser-visible BFF path; requests are proxied on the web origin.
NEXT_PUBLIC_BFF_URL=/v1
BFF_UPSTREAM_URL=http://localhost:3002/v1

# Web-internal key (TD38) — shared secret between web and BFF, sent as X-Web-Internal-Key on
# every BFF call (generate with: openssl rand -hex 32). Must be identical in both
# apps/web/.env and apps/bff/.env. Required unconditionally, in every environment.
WEB_INTERNAL_KEY=change-me-generate-with-openssl-rand-hex-32

# BFF Cloud Run IAM authentication (TD38) — "none" for local dev (default). "iam" is required
# whenever NODE_ENV=production (both staging and prod cloud builds set NODE_ENV=production);
# startup fails otherwise. In "iam" mode web attaches a Google-signed ID token to every BFF
# request, on top of (not instead of) WEB_INTERNAL_KEY above.
BFF_AUTH_MODE=none
# Audience for the ID token — defaults to BFF_UPSTREAM_URL's origin if unset.
# BFF_AUDIENCE=

# Hotsite public image bucket base URL (fake-gcs-server in local dev)
NEXT_PUBLIC_HOTSITE_IMAGE_BASE_URL=http://localhost:4443/ikaro-local-public

# Shared secret for the on-demand ISR revalidation endpoint (/api/revalidate)
# Must be ≥32 chars. Same value must be set in the backend HOTSITE_REVALIDATE_SECRET.
HOTSITE_REVALIDATE_SECRET=change-me-to-a-random-32-char-string

# Public base URL for this deployment — used to build canonical URLs, Open Graph tags,
# JSON-LD structured data, and sitemap.xml entries. https://<ikaro-domain> in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verifies the signed guest info-request token on /bookings/:id/submit-info (M13-S38/S40).
# Same value must be set in the backend/BFF JWT_SECRET — it signs/verifies the same token.
JWT_SECRET=change-me-to-match-the-backend-and-bff-jwt-secret
