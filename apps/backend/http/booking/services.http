# Booking — Service endpoints
# UC-012 (create), UC-013 (update, activate, deactivate), list (public)
# TenantContext is populated from X-Tenant-ID / X-Actor-ID headers (set by BFF).
#
# Prerequisites:
#   1. pnpm infra:up
#   2. pnpm --filter @ikaro/backend run migration:run
#   3. pnpm --filter @ikaro/backend run dev
#
# REST Client environment: select "local" in VS Code status bar

@baseUrl = {{backendUrl}}

# ─────────────────────────────────────────────────────────────────────────────
# HAPPY PATH — list services (public — no actor required)
# ─────────────────────────────────────────────────────────────────────────────

###

### List active services for a tenant (public)
GET {{baseUrl}}/services
X-Tenant-ID: {{tenantId}}

# ─────────────────────────────────────────────────────────────────────────────
# HAPPY PATH — create service (UC-012)
# ─────────────────────────────────────────────────────────────────────────────

###

### Create a new service (MANAGER role)
POST {{baseUrl}}/services
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "name": "Lavagem Completa",
  "description": "Lavagem exterior e interior completa",
  "priceAmount": 150,
  "durationMinutes": 60,
  "loyaltyPointsValue": 10,
  "requiresPickupAddress": false
}

###

### Create a service with pickup address required (STAFF role)
POST {{baseUrl}}/services
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: STAFF

{
  "name": "Lavagem Domiciliar",
  "priceAmount": 200,
  "durationMinutes": 90,
  "loyaltyPointsValue": 15,
  "requiresPickupAddress": true
}

# ─────────────────────────────────────────────────────────────────────────────
# HAPPY PATH — update service (UC-013)
# ─────────────────────────────────────────────────────────────────────────────

###

### Update service name and price (partial update)
PATCH {{baseUrl}}/services/{{serviceId}}
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "name": "Lavagem Completa Premium",
  "priceAmount": 175
}

###

### Clear description (set to null)
PATCH {{baseUrl}}/services/{{serviceId}}
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "description": null
}

# ─────────────────────────────────────────────────────────────────────────────
# HAPPY PATH — resource requirements / legs / buffer / booking model (M22 Cluster 2)
# ─────────────────────────────────────────────────────────────────────────────

###

### Set a flat resource requirement (UC-050)
PATCH {{baseUrl}}/services/{{serviceId}}/resource-requirements
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "resourceRequirements": [
    { "type": "STAFF", "selectionMode": "CUSTOMER_CHOICE" }
  ]
}

###

### Set a bundled resource requirement (UC-051)
PATCH {{baseUrl}}/services/{{serviceId}}/resource-requirements
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "resourceRequirements": [
    { "type": "STAFF", "selectionMode": "CUSTOMER_CHOICE" },
    { "type": "EQUIPMENT", "selectionMode": "AUTO_ANY" }
  ]
}

###

### Set sequential legs (UC-052)
PUT {{baseUrl}}/services/{{serviceId}}/legs
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "legs": [
    { "legIndex": 0, "name": "Sauna", "durationMinutes": 20, "resourceRequirements": [{ "type": "ROOM", "selectionMode": "AUTO_ANY" }], "transitionGapAfterMinutes": 10 },
    { "legIndex": 1, "name": "Massagem", "durationMinutes": 50, "resourceRequirements": [{ "type": "STAFF", "selectionMode": "CUSTOMER_CHOICE" }], "transitionGapAfterMinutes": 0 }
  ]
}

###

### Set the service's buffer override (UC-053)
PATCH {{baseUrl}}/services/{{serviceId}}
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "bufferAfterMinutes": 15
}

###

### Convert an APPOINTMENT service to SESSION (UC-056) — classResourceSlots required in the same request
PATCH {{baseUrl}}/services/{{serviceId}}
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "bookingModel": "SESSION",
  "classResourceSlots": [
    { "type": "ROOM", "eligibleResourceIds": ["00000000-0000-4000-8000-000000000001"] }
  ]
}
# eligibleResourceIds must reference an active ROOM resource ID for this tenant. There is no
# separate slot-management endpoint this milestone — classResourceSlots can only be supplied
# where bookingModel itself is set (here, or at POST /services).

###

### 422 — converting to SESSION without classResourceSlots
PATCH {{baseUrl}}/services/{{serviceId}}
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "bookingModel": "SESSION"
}

###

### Create a SESSION-model service (UC-056)
POST {{baseUrl}}/services
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "name": "Aula de Yoga",
  "priceAmount": 60,
  "durationMinutes": 60,
  "loyaltyPointsValue": 5,
  "bookingModel": "SESSION",
  "classResourceSlots": [
    { "type": "ROOM", "eligibleResourceIds": ["00000000-0000-4000-8000-000000000001"] }
  ]
}
# eligibleResourceIds must reference an active ROOM resource ID for this tenant — set it to a
# real one before sending (an empty pool is rejected: a slot can't round-trip with zero
# resources).

# ─────────────────────────────────────────────────────────────────────────────
# HAPPY PATH — booking policy / booking-intake schema (M22 Cluster 2)
# ─────────────────────────────────────────────────────────────────────────────

###

### Set booking policy (UC-055)
PATCH {{baseUrl}}/services/{{serviceId}}/booking-policy
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "defaultApprovalMode": "MANUAL_APPROVAL",
  "manualHoldMinutes": 30,
  "cancellationWindowHoursOverride": null,
  "recurrenceEligible": true,
  "availabilityAlertEligible": true
}

###

### Set a variable-duration booking policy (UC-055 step 4)
PATCH {{baseUrl}}/services/{{serviceId}}/booking-policy
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "durationPolicy": "CUSTOMER_SELECTED",
  "durationMinMinutes": 60,
  "durationMaxMinutes": 480,
  "durationIncrementMinutes": 30,
  "pricingPolicy": "PER_TIME_INCREMENT",
  "pricingIncrementMinutes": 60,
  "pricePerIncrementAmount": 50.00
}

###

### 422 — variable duration without a pricing policy (UC-055 A2)
PATCH {{baseUrl}}/services/{{serviceId}}/booking-policy
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "durationPolicy": "CUSTOMER_SELECTED"
}

###

### Publish a booking-intake schema (UC-054)
POST {{baseUrl}}/services/{{serviceId}}/intake-schema
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "questions": [
    { "fieldKey": "accessNeeds", "label": "Necessidades de acesso", "type": "FREE_TEXT", "required": false }
  ],
  "consentText": "Concordo com os termos de agendamento",
  "requiresNamedAttendees": false,
  "participantCountRequired": false
}

###

### Publish a schema with a PICKUP_ADDRESS question — sets requiresPickupAddress (UC-054 A2)
POST {{baseUrl}}/services/{{serviceId}}/intake-schema
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "questions": [
    { "fieldKey": "pickup", "label": "Endereço de coleta", "type": "PICKUP_ADDRESS", "required": true }
  ],
  "consentText": "Concordo com os termos de agendamento"
}

###

### Read the active intake schema and its version history (UC-054 read path, M22-S04)
GET {{baseUrl}}/services/{{serviceId}}/intake-schema
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

###

### 404 — cross-tenant/missing service id on the intake-schema read path
GET {{baseUrl}}/services/00000000-0000-4000-8000-000000000099/intake-schema
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

###

### 409 — booking-policy/intake-schema on a SESSION service
PATCH {{baseUrl}}/services/{{serviceId}}/booking-policy
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "recurrenceEligible": true
}
# Only valid against an APPOINTMENT service — set serviceId to a SESSION-model service to see
# 409 BOOKING_SERVICE_BOOKING_CONFIG_MODEL_MISMATCH.

# ─────────────────────────────────────────────────────────────────────────────
# HAPPY PATH — activate/deactivate service (UC-013)
# ─────────────────────────────────────────────────────────────────────────────

###

### Activate a deactivated service
PATCH {{baseUrl}}/services/{{serviceId}}/activate
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

###

### Deactivate a service (logical delete — row is preserved)
DELETE {{baseUrl}}/services/{{serviceId}}
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

# ─────────────────────────────────────────────────────────────────────────────
# ERROR CASES
# ─────────────────────────────────────────────────────────────────────────────

###

### 403 — CUSTOMER role not allowed
POST {{baseUrl}}/services
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: CUSTOMER
X-Actor-Role: CUSTOMER

{
  "name": "Lavagem Simples",
  "priceAmount": 80,
  "durationMinutes": 30,
  "loyaltyPointsValue": 5
}

###

### 400 — Negative price
POST {{baseUrl}}/services
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "name": "Lavagem Simples",
  "priceAmount": -50,
  "durationMinutes": 30,
  "loyaltyPointsValue": 5
}

###

### 404 — Service not found
PATCH {{baseUrl}}/services/00000000-0000-4000-8000-000000000099
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "name": "X"
}

###

### 409 — Update on deactivated service
PATCH {{baseUrl}}/services/{{serviceId}}
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "name": "Tentativa apos desativacao"
}

###

### 422 — resource requirement references a type with no active resources
PATCH {{baseUrl}}/services/{{serviceId}}/resource-requirements
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "resourceRequirements": [
    { "type": "EQUIPMENT", "selectionMode": "AUTO_ANY" }
  ]
}

###

### 422 — fewer than 2 legs
PUT {{baseUrl}}/services/{{serviceId}}/legs
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "legs": [
    { "legIndex": 0, "name": "Etapa Unica", "durationMinutes": 30, "resourceRequirements": [{ "type": "ROOM", "selectionMode": "AUTO_ANY" }] }
  ]
}

###

### 409 — resource-requirements on a service that already has legs
PATCH {{baseUrl}}/services/{{serviceId}}/resource-requirements
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "resourceRequirements": [
    { "type": "STAFF", "selectionMode": "CUSTOMER_CHOICE" }
  ]
}

###

### 409 — bookingModel change after the service already has bookings
PATCH {{baseUrl}}/services/{{serviceId}}
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
X-Actor-ID: {{managerId}}
X-Actor-Type: STAFF
X-Actor-Role: MANAGER

{
  "bookingModel": "SESSION"
}
