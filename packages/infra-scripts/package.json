{
  "name": "@ikaro/infra-scripts",
  "version": "0.0.1",
  "private": true,
  "description": "Standalone CI tooling scripts for infra/terraform (env/secret contract check, Pub/Sub topic/subscription catalog) and the deploy pipelines (hotsite template asset sync) — not consumed by any app at runtime",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --no-error-on-unmatched-pattern --cache --cache-location .eslintcache --cache-strategy content",
    "test": "jest",
    "test:cov": "jest --coverage",
    "env-contract": "tsc -p tsconfig.json && node dist/env-contract.js",
    "pubsub-catalog": "tsc -p tsconfig.json && node dist/pubsub-catalog.js",
    "sync-hotsite-template-assets": "tsc -p tsconfig.json && node dist/sync-hotsite-template-assets.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@ikaro/config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.4",
    "eslint-plugin-jest": "^29.16.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11"
  }
}
