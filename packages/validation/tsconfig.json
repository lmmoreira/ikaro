{
  "extends": "@ikaro/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@ikaro/types/testing/*": ["../types/dist/testing/*"]
    },
    "types": ["node", "jest"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
