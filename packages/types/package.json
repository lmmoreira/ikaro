{
  "name": "@ikaro/types",
  "version": "0.0.1",
  "private": true,
  "description": "Shared TypeScript types and DTOs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "protocol/errors": [
        "dist/protocol/errors.d.ts"
      ],
      "protocol/actor": [
        "dist/protocol/actor.d.ts"
      ],
      "protocol/media": [
        "dist/protocol/media.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./protocol/errors": {
      "import": "./dist/protocol/errors.js",
      "require": "./dist/protocol/errors.js",
      "types": "./dist/protocol/errors.d.ts"
    },
    "./protocol/actor": {
      "import": "./dist/protocol/actor.js",
      "require": "./dist/protocol/actor.js",
      "types": "./dist/protocol/actor.d.ts"
    },
    "./protocol/media": {
      "import": "./dist/protocol/media.js",
      "require": "./dist/protocol/media.js",
      "types": "./dist/protocol/media.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --no-error-on-unmatched-pattern",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ikaro/config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.4",
    "eslint-plugin-jest": "^29.16.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "zod": "^4.4.3"
  }
}
