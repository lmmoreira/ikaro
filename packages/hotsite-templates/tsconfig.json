{
  "extends": "@ikaro/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@ikaro/types/testing/*": ["../types/dist/testing/*"]
    },
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "definitions/**/*.json",
    "copy/**/*.json",
    "asset-manifest.json"
  ],
  "exclude": ["node_modules", "dist"]
}
