{
  "name": "@ikaro/hotsite-templates",
  "version": "0.0.1",
  "private": true,
  "description": "Versioned hotsite template catalogue: structure, per-locale copy and the append-only asset manifest. Image binaries live in assets/ and are shipped to the public bucket by the deploy pipelines, never by this package.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --no-error-on-unmatched-pattern --cache --cache-location .eslintcache --cache-strategy content",
    "test": "jest",
    "test:cov": "jest --coverage",
    "build-assets": "tsc && node dist/scripts/build-assets.js"
  },
  "dependencies": {
    "@ikaro/types": "workspace:*"
  },
  "devDependencies": {
    "@ikaro/config": "workspace:*",
    "@ikaro/validation": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.4",
    "eslint-plugin-jest": "^29.16.1",
    "jest": "^30.4.2",
    "sharp": "^0.35.5",
    "ts-jest": "^29.4.11",
    "zod": "^4.6.6"
  }
}
