{
  "version": 1,
  "layerTaxonomy": {
    "domain": { "frameworkFree": true, "allowedRoots": ["domain"] },
    "application": {
      "frameworkFree": false,
      "allowedFrameworkPackages": ["@nestjs/common"],
      "allowedRoots": [
        "domain",
        "application/ports",
        "application/dtos",
        "application/services",
        "shared"
      ],
      "sameContextAllowedApplicationPaths": [
        "application/dtos/**",
        "application/ports/**",
        "application/services/**",
        "application/use-cases/base-*.use-case.ts"
      ],
      "sameContextAllowedApplicationPathsByContext": {
        "booking": [
          "application/use-cases/booking-request.helpers.ts",
          "application/use-cases/booking-request.types.ts"
        ],
        "platform": ["chatbot.constants.ts"]
      }
    },
    "infrastructure": {
      "frameworkFree": false,
      "purpose": ["controllers", "adapters", "repositories", "event-handlers", "composition-roots"]
    },
    "compositionRootExceptions": ["**/*.module.ts"]
  },
